{
  "name": "@iotopen/react-lynx",
  "version": "1.0.1",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "lint": "pnpm type-check && eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "prepare": "node scripts/prepare.cjs",
    "prepack": "node scripts/prepare.cjs",
    "build": "vite build --config ./vite.config.ts",
    "dev": "vite",
    "clean": "rm -rf dist/",
    "publish:prerelease": "pnpm version prerelease --preid=rc && pnpm run build && npm publish --tag rc"
  },
  "publishConfig": {
    "access": "public"
  },
    "repository": {
    "type": "git",
    "url": "https://github.com/IoTOpen/react-lynx.git"
  },
  "peerDependencies": {
    "@iotopen/node-lynx": "^2.5.0",
    "paho-mqtt": "^1.1.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@iotopen/node-lynx": "https://github.com/IoTOpen/node-lynx/releases/download/2.6.0-pre/iotopen-node-lynx-2.6.0-rc.0.tgz",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "6.0.0-rc.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "engines": {
    "node": "22 || 24"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
